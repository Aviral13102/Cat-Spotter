# Environment Configuration for CAT Spotter
# Copy to .env and fill in values

# Global seed for deterministic demos
SEED=42

# Anthropic API (empty = template-only mode, fully functional without it)
ANTHROPIC_API_KEY=
CLAUDE_NUDGE_MODEL=claude-haiku-4-5-20251001
CLAUDE_VOICE_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_S=4

# Fuel & cost assumptions (labelled "Assumed rate" in UI)
DIESEL_PRICE_PER_L=92.0
IDLE_BURN_L_PER_HR=3.0
CO2_KG_PER_L=2.68
TANK_CAPACITY_L=60
START_FUEL_L=28
FUEL_RESERVE_PCT=15
CURRENCY_SYMBOL=₹

# Productivity baselines (derived from real data rows 1 & 3)
PRODUCTIVE_CYCLES_PER_HR=11
FUEL_PER_CYCLE_L=0.52

# Shift configuration
SHIFT_START=08:00
SHIFT_DURATION_HRS=8

# Weather location (Open-Meteo, no API key needed)
SITE_LAT=28.6139
SITE_LON=77.2090

# Demo mode (enables Demo Panel + scripted scenario)
DEMO_MODE=true

# Database
DB_PATH=data/cat_spotter.db

# Server
HOST=0.0.0.0
PORT=8000
