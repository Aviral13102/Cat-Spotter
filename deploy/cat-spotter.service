[Unit]
Description=CAT Spotter Backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/cat-spotter/backend
EnvironmentFile=/opt/cat-spotter/.env
ExecStart=/opt/cat-spotter/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
